<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Hide the original "Fed. States" menu -->
    <record id="contacts.menu_country_state_partner" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <!-- List View for Cities -->
    <record id="view_res_city_tree" model="ir.ui.view">
        <field name="name">res.city.list</field>
        <field name="model">res.city</field>
        <field name="arch" type="xml">
            <list string="Cities" editable="bottom">
                <field name="name"/>
                <field name="state_id" options="{'no_create': True}"/>
                <field name="country_id" options="{'no_create': True}" readonly="1" force_save="1"/>
            </list>
        </field>
    </record>

    <!-- Form View for Cities -->
    <record id="view_res_city_form" model="ir.ui.view">
        <field name="name">res.city.form</field>
        <field name="model">res.city</field>
        <field name="arch" type="xml">
            <form string="City">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="state_id"/>
                        <!-- THIS IS THE FIX: Added force_save="1" -->
                        <field name="country_id" readonly="1" force_save="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Window Action and Menu -->
    <record id="action_res_city" model="ir.actions.act_window">
        <field name="name">Cities</field>
        <field name="res_model">res.city</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem
        id="menu_res_city"
        name="Cities"
        parent="contacts.menu_localisation"
        action="action_res_city"
        sequence="2"/>
</odoo>