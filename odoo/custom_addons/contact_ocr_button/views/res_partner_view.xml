<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_partner_form_add_ocr_button" model="ir.ui.view">
        <field name="name">res.partner.form.ocr.button</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>

        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">

                <button name="action_scan_via_ocr"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-camera">

                    <div class="o_stat_info">
                        <span class="o_stat_text">Scan</span>
                        <span class="o_stat_text">Card</span>
                    </div>

                </button>

            </xpath>
        </field>
    </record>

</odoo>