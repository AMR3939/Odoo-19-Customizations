<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View for Universities (already exists) -->
    <record id="view_res_university_tree" model="ir.ui.view">
        <field name="name">res.university.tree</field>
        <field name="model">res.university</field>
        <field name="arch" type="xml">
            <list string="Universities" editable="bottom">
                <field name="name"/>
                <field name="city_id"/>
                <field name="country_id"/>
            </list>
        </field>
    </record>

    <!-- NEW: Form View for Universities -->
    <record id="view_res_university_form" model="ir.ui.view">
        <field name="name">res.university.form</field>
        <field name="model">res.university</field>
        <field name="arch" type="xml">
            <form string="University">
                <sheet>
                    <group>
                        <field name="name"/>
                        <!-- city_id is now required in the model, and will be shown as such in the form -->
                        <field name="city_id"/>
                        <!-- country_id is related and readonly, automatically populated from city_id -->
                        <field name="country_id" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Update the window action to include the form view -->
    <record id="action_res_university" model="ir.actions.act_window">
        <field name="name">Universities</field>
        <field name="res_model">res.university</field>
        <field name="view_mode">list,form</field> <!-- Ensure 'form' is included -->
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new university for your recruitment needs.
            </p>
        </field>
    </record>

</odoo>