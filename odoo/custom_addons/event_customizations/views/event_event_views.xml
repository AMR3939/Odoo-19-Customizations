<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <data>

        <!-- =====================================================
             Event QR Code Form Customization
        ====================================================== -->

        <record id="view_event_form_inherit_qr"
                model="ir.ui.view">

            <field name="name">event.event.form.qr</field>

            <field name="model">event.event</field>

            <field name="inherit_id"
                   ref="event.view_event_form"/>

            <field name="arch"
                   type="xml">

                <!-- =============================================
                     Insert QR Code Section
                ============================================== -->

                <xpath expr="//field[@name='name']"
                       position="after">

                    <group>

                        <field name="qr_code"
                               widget="image"
                               string="QR Code"
                               filename="qr_code_filename"
                               options="{'preview_image': 'qr_code'}"/> 

                        <button name="action_download_qr"
                                type="object"
                                string="Download QR Code"
                                class="btn btn-primary"/>

                    </group>

                </xpath>

                <!-- =============================================
                     Insert Is Online Checkbox
                ============================================== -->
                <xpath expr="//field[@name='address_id']"
                       position="before">
                    <field name="is_online"/>
                </xpath>

                <!-- =============================================
                     Insert Online Meeting Tab in Notebook
                ============================================== -->
                <xpath expr="//notebook"
                       position="inside">
                    <page string="Online Meeting"
                          name="online_meeting"
                          invisible="not is_online">
                        <group>
                            <group string="Configuration">
                                <field name="videoconference_provider"
                                       required="is_online"/>
                                <field name="jitsi_room_name"
                                       invisible="videoconference_provider != 'jitsi'"
                                       readonly="1"
                                       style="color: black;"/>
                                <field name="meeting_password"
                                       placeholder="Passcode (Optional)"/>
                            </group>
                            <group string="Meeting Connection">
                                <field name="meeting_url"
                                       widget="url"
                                       readonly="videoconference_provider == 'jitsi'"
                                       string="Meeting URL"
                                       required="is_online"
                                       style="color: black;"/>
                                <div colspan="2" class="mt-2">
                                    <button name="action_generate_meeting_link"
                                            type="object"
                                            string="Generate / Refresh Link"
                                            class="btn btn-secondary"
                                            invisible="videoconference_provider == 'jitsi'"/>
                                </div>
                            </group>
                        </group>
                    </page>
                </xpath>

            </field>

        </record>

    </data>

</odoo>