<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- =====================================================
             Inherit Registration Form: Add Secure Join URL field
             and "Join Meeting" button in header for online events
        ====================================================== -->
        <record id="view_event_registration_form_inherit_online" model="ir.ui.view">
            <field name="name">event.registration.form.inherit.online.meeting</field>
            <field name="model">event.registration</field>
            <field name="inherit_id" ref="event.view_event_registration_form"/>
            <field name="arch" type="xml">

                <!-- Add "Join Meeting" button in the form header -->
                <xpath expr="//header/button[@name='action_send_badge_email']" position="before">
                    <button name="action_open_meeting_link"
                            string="Join Meeting"
                            type="object"
                            class="btn btn-primary"
                            invisible="not event_is_online or state not in ('open', 'done')"/>
                </xpath>

                <!-- Add secure join URL in the Event Information group -->
                <xpath expr="//group[@name='event']" position="inside">
                    <field name="event_is_online" invisible="1"/>
                    <field name="secure_join_url"
                           string="Secure Meeting Link"
                           widget="url"
                           readonly="1"
                           invisible="not event_is_online"/>
                </xpath>

            </field>
        </record>

    </data>
</odoo>
