<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form_inherit_online_event" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.online.event</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="event.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//block[@name='attendance_setting_container']" position="after">
                    <block title="Online Events" name="online_event_setting_container">
                        <setting title="Configure global settings for online events video conferencing providers." string="Video Conferencing" help="Setup servers &amp; API keys for Jitsi, Zoom, Google Meet and Microsoft Teams.">

                            <!-- Jitsi Server URL -->
                            <div class="content-group mt16">
                                <label for="jitsi_server_url" class="o_form_label col-lg-3 o_light_label"/>
                                <field name="jitsi_server_url" placeholder="https://meet.jit.si"/>
                            </div>

                            <!-- Zoom credentials -->
                            <div class="content-group mt16">
                                <label for="zoom_client_id" class="o_form_label col-lg-3 o_light_label"/>
                                <field name="zoom_client_id" placeholder="Client ID"/>
                            </div>
                            <div class="content-group">
                                <label for="zoom_client_secret" class="o_form_label col-lg-3 o_light_label"/>
                                <field name="zoom_client_secret" password="True" placeholder="Client Secret"/>
                            </div>

                            <!-- Google Meet credentials -->
                            <div class="content-group mt16">
                                <label for="google_meet_client_id" class="o_form_label col-lg-3 o_light_label"/>
                                <field name="google_meet_client_id" placeholder="Client ID"/>
                            </div>
                            <div class="content-group">
                                <label for="google_meet_client_secret" class="o_form_label col-lg-3 o_light_label"/>
                                <field name="google_meet_client_secret" password="True" placeholder="Client Secret"/>
                            </div>

                            <!-- Microsoft Teams credentials -->
                            <div class="content-group mt16">
                                <label for="teams_client_id" class="o_form_label col-lg-3 o_light_label"/>
                                <field name="teams_client_id" placeholder="Client ID"/>
                            </div>
                            <div class="content-group">
                                <label for="teams_client_secret" class="o_form_label col-lg-3 o_light_label"/>
                                <field name="teams_client_secret" password="True" placeholder="Client Secret"/>
                            </div>

                        </setting>
                    </block>
                </xpath>
            </field>
        </record>
    </data>
</odoo>