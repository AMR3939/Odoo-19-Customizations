<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- 1. Graphic Designer: Restricted to Own Products -->
        <record id="rule_graphic_designer_own_products" model="ir.rule">
            <field name="name">Graphic Designer: Own Products Only</field>
            <field name="model_id" ref="product.model_product_template"/>
            <field name="groups" eval="[(4, ref('graphic_designer_workflow.group_graphic_designer'))]"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
        </record>

        <!-- 2. Design Manager & Above: See All Products -->
        <!-- This un-restricts" the roles above Graphic Designer -->
        <record id="rule_inventory_manager_all_products" model="ir.rule">
            <field name="name">Inventory Manager: See All Products</field>
            <field name="model_id" ref="product.model_product_template"/>
            <field name="groups" eval="[(4, ref('graphic_designer_workflow.group_design_manager')), (4, ref('graphic_designer_workflow.group_ecommerce_head')), (4, ref('stock.group_stock_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
    </data>
</odoo>