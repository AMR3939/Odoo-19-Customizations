<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_reject_reason_wizard_form" model="ir.ui.view">
        <field name="name">reject.reason.wizard.form</field>
        <field name="model">reject.reason.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Reason">
                <group>
                    <field name="product_id" invisible="1"/>
                    <field name="reject_reason" placeholder="Enter the reason for rejection..."/>
                </group>
                <footer>
                    <button name="action_confirm_reject" string="Confirm Reject" type="object" class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>