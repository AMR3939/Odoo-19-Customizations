<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="blacklist_reason_misconduct" model="hr.employee.blacklist.reason">
        <field name="name">Misconduct</field>
        <field name="sequence">10</field>
        <field name="description">Employee was blacklisted due to misconduct.</field>
    </record>

    <record id="blacklist_reason_fraud" model="hr.employee.blacklist.reason">
        <field name="name">Fraud</field>
        <field name="sequence">20</field>
        <field name="description">Employee was blacklisted due to fraud or false information.</field>
    </record>

    <record id="blacklist_reason_absconded" model="hr.employee.blacklist.reason">
        <field name="name">Absconded</field>
        <field name="sequence">30</field>
        <field name="description">Employee left the organization without proper notice.</field>
    </record>

    <record id="blacklist_reason_policy_violation" model="hr.employee.blacklist.reason">
        <field name="name">Policy Violation</field>
        <field name="sequence">40</field>
        <field name="description">Employee violated company policy.</field>
    </record>

    <record id="blacklist_reason_poor_conduct" model="hr.employee.blacklist.reason">
        <field name="name">Poor Conduct</field>
        <field name="sequence">50</field>
        <field name="description">Employee was blacklisted due to poor professional conduct.</field>
    </record>

    <record id="blacklist_reason_other" model="hr.employee.blacklist.reason">
        <field name="name">Other</field>
        <field name="sequence">60</field>
        <field name="description">Other blacklist reason.</field>
    </record>

</odoo>