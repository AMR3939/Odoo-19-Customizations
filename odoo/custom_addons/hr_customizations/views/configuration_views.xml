<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Degree Views & Actions -->
    <!-- THIS IS THE FIX: Added an explicit list view with editable="bottom" -->
    <record id="hr_employee_degree_view_tree" model="ir.ui.view">
        <field name="name">hr.employee.degree.list.editable</field>
        <field name="model">hr.employee.degree</field>
        <field name="arch" type="xml">
            <list string="Degrees" editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>
    <record id="hr_employee_degree_action" model="ir.actions.act_window">
        <field name="name">Degrees</field>
        <field name="res_model">hr.employee.degree</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Stream Views & Actions -->

    <record id="hr_employee_stream_view_tree" model="ir.ui.view">
        <field name="name">hr.employee.stream.list.editable</field>
        <field name="model">hr.employee.stream</field>
        <field name="arch" type="xml">
            <list string="Streams" editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>
    <record id="hr_employee_stream_action" model="ir.actions.act_window">
        <field name="name">Streams</field>
        <field name="res_model">hr.employee.stream</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- University Views & Actions -->
    <record id="hr_employee_university_view_tree" model="ir.ui.view">
        <field name="name">hr.employee.university.list</field>
        <field name="model">hr.employee.university</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name" string="University Name"/>
                <field name="city_id"/>
                <field name="state_id"/>
                <field name="country_id"/>
            </list>
        </field>
    </record>
    <record id="hr_employee_university_action" model="ir.actions.act_window">
        <field name="name">Universities</field>
        <field name="res_model">hr.employee.university</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Place of Birth Views & Actions -->
    <record id="hr_employee_place_of_birth_view_tree" model="ir.ui.view">
        <field name="name">hr.employee.place.of.birth.list</field>
        <field name="model">hr.employee.place_of_birth</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="city_id"/>
                <field name="state_id"/>
                <field name="country_id"/>
            </list>
        </field>
    </record>
    <record id="hr_employee_place_of_birth_action" model="ir.actions.act_window">
        <field name="name">Places of Birth</field>
        <field name="res_model">hr.employee.place_of_birth</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>