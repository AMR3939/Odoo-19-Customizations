<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================================================= -->
    <!-- Blacklist Reason Views                                    -->
    <!-- ========================================================= -->

    <record id="view_hr_employee_blacklist_reason_list"
            model="ir.ui.view">
        <field name="name">hr.employee.blacklist.reason.list</field>
        <field name="model">hr.employee.blacklist.reason</field>
        <field name="arch" type="xml">
            <list string="Blacklist Reasons">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="description"/>
                <field name="active"/>
            </list>
        </field>
    </record>


    <record id="view_hr_employee_blacklist_reason_form"
            model="ir.ui.view">
        <field name="name">hr.employee.blacklist.reason.form</field>
        <field name="model">hr.employee.blacklist.reason</field>
        <field name="arch" type="xml">
            <form string="Blacklist Reason">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="action_hr_employee_blacklist_reason"
            model="ir.actions.act_window">
        <field name="name">Blacklist Reasons</field>
        <field name="res_model">hr.employee.blacklist.reason</field>
        <field name="view_mode">list,form</field>
    </record>


    <!-- ========================================================= -->
    <!-- Blacklist Wizard                                          -->
    <!-- ========================================================= -->

    <record id="view_hr_employee_blacklist_wizard_form"
            model="ir.ui.view">
        <field name="name">hr.employee.blacklist.wizard.form</field>
        <field name="model">hr.employee.blacklist.wizard</field>

        <field name="arch" type="xml">
            <form string="Blacklist Employee">

                <sheet>
                    <group>
                        <field name="employee_ids"
                               widget="many2many_tags"
                               readonly="1"/>

                        <field name="reason_id"
                               options="{'no_create_edit': False}"/>

                        <field name="description"
                               placeholder="Enter detailed reason for blacklisting..."/>
                    </group>
                </sheet>

                <footer>
                    <button name="action_confirm_blacklist"
                            type="object"
                            string="Blacklist"
                            class="btn-primary"/>

                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>

            </form>
        </field>
    </record>


    <!-- ========================================================= -->
    <!-- Employee Form: Blacklisted Ribbon and Details              -->
    <!-- ========================================================= -->

    <record id="view_hr_employee_form_inherit_blacklist"
            model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.blacklist</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>

        <field name="arch" type="xml">

            <!-- Fields required by visibility expressions -->
            <xpath expr="//sheet" position="inside">
                <field name="is_blacklisted_employee" invisible="1"/>
                <field name="is_intern_employee" invisible="1"/>
            </xpath>


            <!-- Hide the standard Archived ribbon when blacklisted -->
            <xpath expr="//sheet/widget[@name='web_ribbon'][1]"
                   position="attributes">
                <attribute name="invisible">
                    active or is_blacklisted_employee
                </attribute>
            </xpath>


            <!-- Custom Blacklisted ribbon -->
            <xpath expr="//sheet" position="inside">
                <widget name="web_ribbon"
                        title="Blacklisted"
                        bg_color="text-bg-dark"
                        invisible="not is_blacklisted_employee"/>
            </xpath>


            <!-- Blacklist Details tab -->
            <xpath expr="//notebook" position="inside">
                <page string="Blacklist Details"
                      name="blacklist_details"
                      invisible="not is_blacklisted_employee">

                    <group>
                        <group>
                            <field name="is_blacklisted_employee"
                                   readonly="1"/>

                            <field name="is_intern_employee"
                                   string="Intern Employee"
                                   readonly="1"/>

                            <field name="blacklist_reason_id"
                                   readonly="1"/>

                            <field name="blacklist_date"
                                   readonly="1"/>

                            <field name="blacklisted_by_id"
                                   readonly="1"/>
                        </group>

                        <group>
                            <field name="whitelist_date"
                                   readonly="1"/>

                            <field name="whitelisted_by_id"
                                   readonly="1"/>
                        </group>
                    </group>

                    <group>
                        <field name="blacklist_description"
                               readonly="1"/>
                    </group>

                </page>
            </xpath>

        </field>
    </record>


    <!-- ========================================================= -->
    <!-- Server Actions                                            -->
    <!-- ========================================================= -->

    <record id="action_blacklist_employee_server"
            model="ir.actions.server">
        <field name="name">Blacklist</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="binding_model_id" ref="hr.model_hr_employee"/>
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">action = records.action_open_blacklist_wizard()</field>
    </record>


    <record id="action_whitelist_employee_server"
            model="ir.actions.server">
        <field name="name">Whitelist</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="binding_model_id" ref="hr.model_hr_employee"/>
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">action = records.action_whitelist_employee()</field>
    </record>


    <!-- ========================================================= -->
    <!-- Configuration Menu                                        -->
    <!-- ========================================================= -->
    <menuitem id="menu_hr_employee_blacklist_reason"
          name="Blacklist Reasons"
          parent="hr.menu_config_employee"
          action="action_hr_employee_blacklist_reason"
          sequence="7"/>


    <!-- ========================================================= -->
    <!-- Normal Employees Action                                   -->
    <!-- Interns are hidden from the normal Employees menu.         -->
    <!-- ========================================================= -->

    <record id="hr.open_view_employee_list_my"
            model="ir.actions.act_window">
        <field name="domain">[
            ('company_id', 'in', allowed_company_ids),
            ('is_intern_employee', '=', False)
        ]</field>
    </record>


    <!-- ========================================================= -->
    <!-- Blacklisted Employee Search View                          -->
    <!--                                                           -->
    <!-- Keeps the complete original employee search view.          -->
    <!-- Only Employee Type is replaced by Employee and Intern.     -->
    <!-- ========================================================= -->

    <record id="view_hr_blacklisted_employee_search"
        model="ir.ui.view">

    <field name="name">hr.employee.search.blacklisted</field>
    <field name="model">hr.employee</field>
    <field name="inherit_id" ref="hr.view_employee_filter"/>
    <field name="mode">primary</field>
    <field name="priority" eval="50"/>

    <field name="arch" type="xml">

        <!-- Remove the original Employee Type Group By option -->
        <xpath expr="//filter[@name='group_employee_type']"
               position="replace"/>

        <!-- Add Employee and Intern immediately before Archive -->
        <xpath expr="//filter[@name='inactive']"
               position="before">

            <filter name="filter_blacklisted_employee"
                    string="Employee"
                    domain="[('is_intern_employee', '=', False)]"/>

            <filter name="filter_blacklisted_intern"
                    string="Intern"
                    domain="[('is_intern_employee', '=', True)]"/>

        </xpath>

        <!-- Rename Archived to Archive -->
        <xpath expr="//filter[@name='inactive']"
               position="attributes">
            <attribute name="string">Archive</attribute>
        </xpath>

         </field>

    </record>


    <!-- ========================================================= -->
    <!-- Blacklisted Employees Action                              -->
    <!-- ========================================================= -->

    <record id="action_hr_blacklisted_employees"
            model="ir.actions.act_window">
        <field name="name">Blacklisted Employees</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">kanban,list,form,activity</field>

        <field name="domain">[
            ('company_id', 'in', allowed_company_ids),
            ('is_blacklisted_employee', '=', True)
        ]</field>

        <!-- Blacklisted records are archived -->
        <field name="context">{
            'active_test': False,
            'searchpanel_default_company_id': allowed_company_ids[0]
        }</field>

        <field name="search_view_id"
               ref="view_hr_blacklisted_employee_search"/>
    </record>


    <!-- ========================================================= -->
    <!-- Blacklisted Menu inside Employees App                     -->
    <!-- ========================================================= -->

    <menuitem id="menu_hr_blacklisted_employees"
              name="Blacklisted"
              parent="hr.menu_hr_root"
              action="action_hr_blacklisted_employees"
              sequence="7"/>

</odoo>