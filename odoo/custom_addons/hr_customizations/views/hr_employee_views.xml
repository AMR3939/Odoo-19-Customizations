<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>

        <!-- =====================================================
             Employee Form Customizations
        ====================================================== -->

        <record id="hr_employee_view_form_customizations"
                model="ir.ui.view">

            <field name="name">hr.employee.form.customizations</field>

            <field name="model">hr.employee</field>

            <field name="inherit_id"
                   ref="hr.view_employee_form"/>

            <field name="arch"
                   type="xml">

                <!-- =============================================
                     Education Fields
                ============================================== -->

                <xpath expr="//field[@name='certificate']"
                       position="after">

                    <field name="degree_id"
                           string="Degree"/>

                    <field name="stream_id"
                           string="Stream"/>

                    <field name="university_id"
                           string="University"/>

                </xpath>


                <!-- =============================================
                     Replace Place of Birth
                ============================================== -->

                <xpath expr="//field[@name='place_of_birth']"
                       position="after">

                    <field name="place_of_birth_id"/>

                </xpath>


                <!-- =============================================
                     Replace Employee Name
                ============================================== -->

                <xpath expr="//field[@name='name']"
                       position="replace">

                    <field name="first_name"
                           placeholder="First Name"
                           required="1"
                           style="font-size: min(3vw, 2rem);"/>

                    <separator/>

                    <field name="middle_name"
                           placeholder="Middle Name"
                           required="1"
                           style="font-size: min(3vw, 2rem);"/>

                    <separator/>

                    <field name="last_name"
                           placeholder="Last Name"
                           required="1"
                           style="font-size: min(3vw, 2rem);"/>

                </xpath>


                <!-- =============================================
                     Emergency Contact 2
                ============================================== -->

                <xpath expr="//field[@name='emergency_phone']"
                       position="after">

                    <field name="emergency_contact_2"/>

                    <field name="emergency_phone_2"
                           class="o_force_ltr"/>

                </xpath>


                <!-- =============================================
                     Resume Upload Fields
                ============================================== -->

                <xpath expr="//field[@name='job_title']"
                       position="after">

                    <field name="resume_doc"
                           filename="resume_filename"
                           widget="binary"/>

                    <field name="resume_filename"
                           invisible="1"/>

                    <button name="action_view_pdf"
                            string="View CV"
                            type="object"
                            class="btn btn-primary"/>

                </xpath>

            </field>

        </record>


        <!-- =====================================================
             Resume PDF Popup View
        ====================================================== -->

        <record id="view_pdf_popup"
                model="ir.ui.view">

            <field name="name">hr.employee.pdf.popup</field>

            <field name="model">hr.employee</field>

            <field name="arch"
                   type="xml">

                <form create="false"
                      edit="false"
                      delete="false">

                    <sheet>

                        <field name="resume_doc"
                               filename="resume_filename"
                               widget="pdf_viewer"/>

                    </sheet>

                </form>

            </field>

        </record>

    </data>

</odoo>