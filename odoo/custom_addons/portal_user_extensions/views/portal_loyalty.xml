<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_loyalty_detail" name="My Loyalty Points">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">My Loyalty Points</t>
            </t>
            
            <div class="o_portal_details">
                <div class="gg_loyalty_summary alert alert-info mb-4">
                    <strong>Total Points: </strong>
                    <span t-esc="'%.0f' % loyalty_points_total"/>
                </div>
                
                <t t-if="not history">
                    <p class="text-muted">No loyalty point activity found.</p>
                </t>
                
                <t t-if="history">
                    <div class="table-responsive">
                        <table class="table table-striped table-sm gg_loyalty_table">
                            <thead class="thead-dark">
                                <tr>
                                    <th>Date</th>
                                    <th>Description</th>
                                    <th class="text-end">Points</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="history" t-as="line">
                                    <tr t-attf-class="#{'table-success' if line['points'] > 0 else 'table-danger'}">
                                        <td t-esc="line['date']"/>
                                        <td t-esc="line['description']"/>
                                        <td class="text-end fw-bold"
                                            t-attf-class="#{'text-success' if line['points'] > 0 else 'text-danger'}">
                                            <t t-esc="'%+.0f' % line['points']"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </div>
        </t>
    </template>
</odoo>
