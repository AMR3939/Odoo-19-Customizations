<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================================================= -->
    <!-- Intern Recruitment Security Category / Privilege            -->
    <!-- Odoo 19: category_id goes on res.groups.privilege, not      -->
    <!-- directly on res.groups.                                    -->
    <!-- ========================================================= -->

    <record id="module_category_intern_recruitment" model="ir.module.category">
        <field name="name">Intern Recruitment</field>
        <field name="sequence">35</field>
    </record>

    <record id="privilege_intern_recruitment" model="res.groups.privilege">
        <field name="name">Intern Recruitment</field>
        <field name="category_id" ref="recruitment_stages_status_enhancement.module_category_intern_recruitment"/>
        <field name="sequence">10</field>
    </record>

    <!-- ========================================================= -->
    <!-- Intern Recruitment Security Groups                         -->
    <!-- ========================================================= -->

    <record id="group_intern_recruitment_user" model="res.groups">
        <field name="name">Intern Recruitment User</field>
        <field name="privilege_id" ref="recruitment_stages_status_enhancement.privilege_intern_recruitment"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_intern_recruitment_manager" model="res.groups">
        <field name="name">Intern Recruitment Manager</field>
        <field name="privilege_id" ref="recruitment_stages_status_enhancement.privilege_intern_recruitment"/>
        <field name="implied_ids" eval="[(4, ref('recruitment_stages_status_enhancement.group_intern_recruitment_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <!-- ========================================================= -->
    <!-- Intern Job Record Rules                                   -->
    <!-- ========================================================= -->

    <record id="rule_intern_job_user" model="ir.rule">
        <field name="name">Intern Job: User Access</field>
        <field name="model_id" ref="model_intern_job"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('recruitment_stages_status_enhancement.group_intern_recruitment_user'))]"/>
    </record>

    <record id="rule_intern_job_manager" model="ir.rule">
        <field name="name">Intern Job: Manager Access</field>
        <field name="model_id" ref="model_intern_job"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('recruitment_stages_status_enhancement.group_intern_recruitment_manager'))]"/>
    </record>

    <!-- ========================================================= -->
    <!-- Intern Applicant Record Rules                             -->
    <!-- ========================================================= -->

    <record id="rule_intern_applicant_user" model="ir.rule">
        <field name="name">Intern Applicant: User Access</field>
        <field name="model_id" ref="model_intern_applicant"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('recruitment_stages_status_enhancement.group_intern_recruitment_user'))]"/>
    </record>

    <record id="rule_intern_applicant_manager" model="ir.rule">
        <field name="name">Intern Applicant: Manager Access</field>
        <field name="model_id" ref="model_intern_applicant"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('recruitment_stages_status_enhancement.group_intern_recruitment_manager'))]"/>
    </record>

    <!-- ========================================================= -->
    <!-- Intern Workflow Stage Record Rules                         -->
    <!-- ========================================================= -->

    <record id="rule_intern_recruitment_stage_user" model="ir.rule">
        <field name="name">Intern Workflow Stage: User Access</field>
        <field name="model_id" ref="model_intern_recruitment_stage"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('recruitment_stages_status_enhancement.group_intern_recruitment_user'))]"/>
    </record>

    <record id="rule_intern_recruitment_stage_manager" model="ir.rule">
        <field name="name">Intern Workflow Stage: Manager Access</field>
        <field name="model_id" ref="model_intern_recruitment_stage"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('recruitment_stages_status_enhancement.group_intern_recruitment_manager'))]"/>
    </record>

    <!-- ========================================================= -->
    <!-- Intern Workflow History Record Rules                       -->
    <!-- ========================================================= -->

    <record id="rule_intern_workflow_history_user" model="ir.rule">
        <field name="name">Intern Workflow History: User Access</field>
        <field name="model_id" ref="model_intern_workflow_history"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('recruitment_stages_status_enhancement.group_intern_recruitment_user'))]"/>
    </record>

    <record id="rule_intern_workflow_history_manager" model="ir.rule">
        <field name="name">Intern Workflow History: Manager Access</field>
        <field name="model_id" ref="model_intern_workflow_history"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('recruitment_stages_status_enhancement.group_intern_recruitment_manager'))]"/>
    </record>

</odoo>