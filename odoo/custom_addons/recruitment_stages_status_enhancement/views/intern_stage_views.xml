<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================================================= -->
    <!-- Intern Workflow Stage List View                            -->
    <!-- ========================================================= -->

    <record id="view_intern_recruitment_stage_list" model="ir.ui.view">
        <field name="name">intern.recruitment.stage.list</field>
        <field name="model">intern.recruitment.stage</field>
        <field name="arch" type="xml">
            <list string="Intern Workflow Stages" default_order="sequence asc, id asc">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="intern_workflow_category"/>
                <field name="intern_initial_stage"/>
                <field name="intern_final_stage"/>
                <!-- <field name="intern_rejected_stage"/>-->
                <field name="intern_create_employee_stage"/>
                <field name="intern_is_post_hiring_stage"/>
                <field name="intern_requires_approval"/>
                <field name="intern_allow_send_back"/>
                <field name="intern_allow_reject"/>
                <field name="fold"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- ========================================================= -->
    <!-- Intern Workflow Stage Form View                            -->
    <!-- ========================================================= -->

    <record id="view_intern_recruitment_stage_form" model="ir.ui.view">
        <field name="name">intern.recruitment.stage.form</field>
        <field name="model">intern.recruitment.stage</field>
        <field name="arch" type="xml">
            <form string="Intern Workflow Stage">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Stage Name" required="1"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Stage Order">
                            <field name="sequence"/>
                            <field name="intern_workflow_category" required="1"/>
                            <field name="fold"/>
                            <field name="active"/>
                        </group>

                        <group string="Workflow Behaviour">
                            <field name="intern_requires_approval"/>
                            <field name="intern_allow_send_back"/>
                            <field name="intern_allow_reject"/>
                            <field name="intern_initial_stage"/>
                            <field name="intern_final_stage"/>
                            <field name="intern_rejected_stage"/>
                        </group>
                    </group>

                    <group>
                        <group string="Hiring Options">
                            <field name="intern_create_employee_stage"/>
                            <field name="intern_is_post_hiring_stage"/>
                        </group>

                        <group string="Visual">
                            <field name="color"/>
                        </group>
                    </group>

                    <group string="Description">
                        <field name="description" placeholder="Add notes about this stage..."/>
                    </group>

                    <div class="alert alert-info" role="alert">
                        The intern workflow is controlled by the sequence number.
                        When a new stage is added, the system automatically places it
                        in the workflow based on its sequence.
                    </div>

                    <div class="alert alert-warning" role="alert">
                        Rejected stage is not part of the normal next/previous movement.
                        It is used only when the Reject button is clicked.
                    </div>
                </sheet>

                <chatter/>
            </form>
        </field>
    </record>

    <!-- ========================================================= -->
    <!-- Intern Workflow Stage Kanban View                          -->
    <!-- ========================================================= -->

    <record id="view_intern_recruitment_stage_kanban" model="ir.ui.view">
        <field name="name">intern.recruitment.stage.kanban</field>
        <field name="model">intern.recruitment.stage</field>
        <field name="arch" type="xml">
            <kanban string="Intern Workflow Stages"
                    default_order="sequence asc, id asc"
                    records_draggable="1">

                <field name="name"/>
                <field name="sequence"/>
                <field name="intern_workflow_category"/>
                <field name="intern_initial_stage"/>
                <field name="intern_final_stage"/>
                <field name="intern_rejected_stage"/>
                <field name="intern_create_employee_stage"/>
                <field name="intern_is_post_hiring_stage"/>
                <field name="fold"/>
                <field name="color"/>

                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <strong>
                                    <field name="sequence"/>
                                    -
                                    <field name="name"/>
                                </strong>
                            </div>

                            <div class="text-muted mt-1">
                                <field name="intern_workflow_category"/>
                            </div>

                            <div class="mt-2">
                                <t t-if="record.intern_initial_stage.raw_value">
                                    <span class="badge rounded-pill text-bg-primary">
                                        Initial
                                    </span>
                                </t>

                                <t t-if="record.intern_final_stage.raw_value">
                                    <span class="badge rounded-pill text-bg-success">
                                        Final
                                    </span>
                                </t>

                                <t t-if="record.intern_rejected_stage.raw_value">
                                    <span class="badge rounded-pill text-bg-danger">
                                        Rejected
                                    </span>
                                </t>

                                <t t-if="record.intern_create_employee_stage.raw_value">
                                    <span class="badge rounded-pill text-bg-warning">
                                        Create Employee
                                    </span>
                                </t>

                                <t t-if="record.intern_is_post_hiring_stage.raw_value">
                                    <span class="badge rounded-pill text-bg-info">
                                        Onboarding Stage
                                    </span>
                                </t>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ========================================================= -->
    <!-- Intern Workflow Stage Search View                          -->
    <!-- ========================================================= -->

    <record id="view_intern_recruitment_stage_search" model="ir.ui.view">
        <field name="name">intern.recruitment.stage.search</field>
        <field name="model">intern.recruitment.stage</field>
        <field name="arch" type="xml">
            <search string="Search Intern Workflow Stages">
                <field name="name"/>
                <field name="intern_workflow_category"/>

                <filter name="filter_active"
                        string="Active"
                        domain="[('active', '=', True)]"/>

                <filter name="filter_archived"
                        string="Archived"
                        domain="[('active', '=', False)]"/>

                <separator/>

                <filter name="filter_main_workflow"
                        string="Main Workflow"
                        domain="[('intern_rejected_stage', '=', False)]"/>

                <filter name="filter_initial_stage"
                        string="Initial Stage"
                        domain="[('intern_initial_stage', '=', True)]"/>

                <filter name="filter_final_stage"
                        string="Final Stage"
                        domain="[('intern_final_stage', '=', True)]"/>

                <filter name="filter_rejected_stage"
                        string="Rejected Stage"
                        domain="[('intern_rejected_stage', '=', True)]"/>

                <filter name="filter_create_employee_stage"
                        string="Create Employee Stage"
                        domain="[('intern_create_employee_stage', '=', True)]"/>

                <filter name="filter_post_hiring_stage"
                        string="Post-Hiring"
                        domain="[('intern_is_post_hiring_stage', '=', True)]"/>

                <separator/>

                <filter name="group_by_category"
                        string="Category"
                        context="{'group_by': 'intern_workflow_category'}"/>

                <filter name="group_by_fold"
                        string="Folded"
                        context="{'group_by': 'fold'}"/>

                <filter name="group_by_active"
                        string="Active"
                        context="{'group_by': 'active'}"/>
            </search>
        </field>
    </record>

    <!-- ========================================================= -->
    <!-- Intern Workflow Stage Action                               -->
    <!-- ========================================================= -->

    <record id="action_intern_recruitment_stage" model="ir.actions.act_window">
        <field name="name">Intern Workflow Stages</field>
        <field name="res_model">intern.recruitment.stage</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[]</field>
        <field name="context">{
            'default_intern_requires_approval': True,
            'default_intern_allow_send_back': True,
            'default_intern_allow_reject': True,
            'default_intern_workflow_category': 'application',
            'search_default_filter_active': 1
        }</field>
        <field name="search_view_id" ref="view_intern_recruitment_stage_search"/>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_intern_recruitment_stage_list')}),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_intern_recruitment_stage_kanban')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_intern_recruitment_stage_form')})
        ]"/>
    </record>

</odoo>