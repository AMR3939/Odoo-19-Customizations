<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================================================= -->
    <!-- Intern Workflow History List View                         -->
    <!-- ========================================================= -->

    <record id="view_intern_workflow_history_list" model="ir.ui.view">
        <field name="name">intern.workflow.history.list</field>
        <field name="model">intern.workflow.history</field>
        <field name="arch" type="xml">
            <list string="Intern Workflow History"
                  default_order="action_date desc, id desc"
                  create="0"
                  edit="0"
                  delete="0">

                <!-- Intern Applicant first -->
                <field name="applicant_id" string="Intern Applicant"/>

                <field name="action_type" string="Action"/>
                <field name="old_stage_id" string="Previous Stage"/>
                <field name="new_stage_id" string="New Stage"/>

                <!-- Action Date after New Stage -->
                <field name="action_date" string="Action Date"/>

                <field name="action_by_id" string="Action By"/>
                <field name="company_id" string="Company"/>
                <field name="remarks" string="Remarks"/>

            </list>
        </field>
    </record>

    <!-- ========================================================= -->
    <!-- Intern Workflow History Form View                         -->
    <!-- ========================================================= -->

    <record id="view_intern_workflow_history_form" model="ir.ui.view">
        <field name="name">intern.workflow.history.form</field>
        <field name="model">intern.workflow.history</field>
        <field name="arch" type="xml">
            <form string="Intern Workflow History"
                  create="0"
                  edit="0"
                  delete="0">
                <sheet>
                    <group>
                        <group string="Applicant Details">
                            <field name="applicant_id" readonly="1"/>
                            <field name="company_id" readonly="1"/>
                        </group>

                        <group string="Action Details">
                            <field name="action_type" readonly="1"/>
                            <field name="action_by_id" readonly="1"/>
                            <field name="action_date" readonly="1"/>
                        </group>
                    </group>

                    <group string="Stage Movement">
                        <group>
                            <field name="old_stage_id" readonly="1"/>
                        </group>

                        <group>
                            <field name="new_stage_id" readonly="1"/>
                        </group>
                    </group>

                    <group string="Remarks">
                        <field name="remarks" readonly="1" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ========================================================= -->
    <!-- Intern Workflow History Search View                       -->
    <!-- ========================================================= -->

    <record id="view_intern_workflow_history_search" model="ir.ui.view">
        <field name="name">intern.workflow.history.search</field>
        <field name="model">intern.workflow.history</field>
        <field name="arch" type="xml">
            <search string="Search Intern Workflow History">

                <field name="applicant_id"/>
                <field name="action_type"/>
                <field name="old_stage_id"/>
                <field name="new_stage_id"/>
                <field name="action_by_id"/>
                <field name="company_id"/>

                <filter string="Created"
                        name="filter_created"
                        domain="[('action_type', '=', 'created')]"/>

                <filter string="Moved to Next Stage"
                        name="filter_approved"
                        domain="[('action_type', '=', 'approved')]"/>

                <filter string="Moved to Previous Stage"
                        name="filter_sent_back"
                        domain="[('action_type', '=', 'sent_back')]"/>

                <filter string="Rejected"
                        name="filter_rejected"
                        domain="[('action_type', '=', 'rejected')]"/>

                <filter string="Employee Created"
                        name="filter_employee_created"
                        domain="[('action_type', '=', 'employee_created')]"/>

                <separator/>

                <filter string="Applicant"
                        name="group_by_applicant"
                        context="{'group_by': 'applicant_id'}"/>

                <filter string="Action"
                        name="group_by_action"
                        context="{'group_by': 'action_type'}"/>

                <filter string="Action By"
                        name="group_by_action_by"
                        context="{'group_by': 'action_by_id'}"/>

                <filter string="Company"
                        name="group_by_company"
                        context="{'group_by': 'company_id'}"
                        groups="base.group_multi_company"/>

                <filter string="Action Date"
                        name="group_by_action_date"
                        context="{'group_by': 'action_date'}"/>

            </search>
        </field>
    </record>

    <!-- ========================================================= -->
    <!-- Intern Workflow History Action                            -->
    <!-- ========================================================= -->

    <record id="action_intern_workflow_history" model="ir.actions.act_window">
        <field name="name">Intern Workflow History</field>
        <field name="res_model">intern.workflow.history</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_intern_workflow_history_search"/>
        <field name="context">{}</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_intern_workflow_history_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_intern_workflow_history_form')})
        ]"/>
    </record>

</odoo>