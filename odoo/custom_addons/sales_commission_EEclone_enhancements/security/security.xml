<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================================================== -->
    <!-- Sales Commission Record -->
    <!-- Managers: see everyone's records.
         Salespeople: see only their own, no matter which
         action/menu/URL is used to reach the model. -->
    <!-- ===================================================== -->

    <record id="rule_commission_record_manager" model="ir.rule">
        <field name="name">Commission Record: Manager sees all</field>
        <field name="model_id" ref="model_sales_commission_record"/>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_commission_record_salesperson" model="ir.rule">
        <field name="name">Commission Record: Salesperson sees own records only</field>
        <field name="model_id" ref="model_sales_commission_record"/>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="domain_force">[('salesperson_id', '=', user.id)]</field>
    </record>


    <!-- ===================================================== -->
    <!-- Sales Commission Adjustment -->
    <!-- Managers: see everyone's adjustments.
        Salespeople: see only their own. -->
    <!-- ===================================================== -->

    <record id="rule_commission_adjustment_manager" model="ir.rule">
        <field name="name">Commission Adjustment: Manager sees all</field>
        <field name="model_id" ref="model_sales_commission_adjustment"/>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_commission_adjustment_salesperson" model="ir.rule">
        <field name="name">Commission Adjustment: Salesperson sees own only</field>
        <field name="model_id" ref="model_sales_commission_adjustment"/>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="domain_force">[('salesperson_id', '=', user.id)]</field>
    </record>

</odoo>