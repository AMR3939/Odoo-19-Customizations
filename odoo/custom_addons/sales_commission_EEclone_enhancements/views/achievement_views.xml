<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View -->
    <record id="view_sales_commission_achievement_tree" model="ir.ui.view">
        <field name="name">sales.commission.achievement.tree</field>
        <field name="model">sales.commission.achievement</field>
        <field name="arch" type="xml">
            <list>
                <field name="achievement_type"/>
                <field name="product_id"/>
                <field name="category_id"/>
                <field name="rate"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_sales_commission_achievement_form" model="ir.ui.view">
        <field name="name">sales.commission.achievement.form</field>
        <field name="model">sales.commission.achievement</field>
        <field name="arch" type="xml">
            <form string="Achievement">
                <sheet>
                    <group>
                        <field name="plan_id"/>
                        <field name="achievement_type"/>
                        <field name="product_id"/>
                        <field name="category_id"/>
                        <field name="rate"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_sales_commission_achievement" model="ir.actions.act_window">
        <field name="name">Achievements</field>
        <field name="res_model">sales.commission.achievement</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>