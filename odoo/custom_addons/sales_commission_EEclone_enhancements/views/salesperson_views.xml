<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===========================================================
                            TREE VIEW
    ============================================================ -->

    <record id="view_sales_commission_salesperson_tree"
            model="ir.ui.view">

        <field name="name">sales.commission.salesperson.tree</field>

        <field name="model">sales.commission.salesperson</field>

        <field name="arch" type="xml">

            <list>

                <field name="user_id"/>

                <field name="date_from"/>

                <field name="date_to"/>

                <field name="other_plan_count"/>

            </list>

        </field>

    </record>


    <!-- ===========================================================
                            FORM VIEW
    ============================================================ -->

    <record id="view_sales_commission_salesperson_form"
            model="ir.ui.view">

        <field name="name">sales.commission.salesperson.form</field>

        <field name="model">sales.commission.salesperson</field>

        <field name="arch" type="xml">

            <form string="Salesperson">

                <sheet>

                    <group>

                        <field name="plan_id"/>

                        <field name="user_id"/>

                        <field name="date_from"/>

                        <field name="date_to"/>

                        <field name="other_plan_count" readonly="1"/>

                    </group>

                </sheet>

            </form>

        </field>

    </record>


    <!-- ===========================================================
                            SEARCH VIEW
    ============================================================ -->

    <record id="view_sales_commission_salesperson_search"
            model="ir.ui.view">

        <field name="name">sales.commission.salesperson.search</field>

        <field name="model">sales.commission.salesperson</field>

        <field name="arch" type="xml">

            <search>

                <field name="user_id"/>

                <field name="plan_id"/>

            </search>

        </field>

    </record>


    <!-- ===========================================================
                            ACTION
    ============================================================ -->

    <record id="action_sales_commission_salesperson"
            model="ir.actions.act_window">

        <field name="name">Sales People</field>

        <field name="res_model">sales.commission.salesperson</field>

        <field name="view_mode">list,form</field>

        <field name="search_view_id"
            ref="view_sales_commission_salesperson_search"/>

    </record>

</odoo>