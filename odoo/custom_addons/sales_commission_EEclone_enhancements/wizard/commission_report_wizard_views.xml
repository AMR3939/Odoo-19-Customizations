<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_sales_commission_wizard" model="ir.actions.report">
        <field name="name">Sales Commission Report</field>
        <field name="model">sales.commission.record</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sales_commission_EEclone_enhancements.report_sales_commission_wizard_document</field>
        <field name="report_file">sales_commission_EEclone_enhancements.report_sales_commission_wizard_document</field>
        <field name="print_report_name">'Sales Commission Report'</field>
        <field name="binding_model_id" eval="False"/>
    </record>

    <record id="view_sales_commission_report_wizard_form" model="ir.ui.view">
        <field name="name">sales.commission.report.wizard.form</field>
        <field name="model">sales.commission.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Sales Commission Report">
                <group>
                    <field name="salesperson_id"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                </group>
                <footer>
                    <button
                        name="action_print_report"
                        string="Print Commission Report"
                        type="object"
                        class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sales_commission_report_wizard" model="ir.actions.act_window">
        <field name="name">Sales Commission Report</field>
        <field name="res_model">sales.commission.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_sales_reporting_commission_pdf"
        name="Sales Commission Report"
        parent="sale.menu_sale_report"
        action="action_sales_commission_report_wizard"
        sequence="61"/>

    <template id="report_sales_commission_wizard_document">
        <t t-call="web.html_container">
            <t t-set="data" t-value="data or {}"/>
            <t t-call="web.external_layout">
                <div class="page">
                    <h2>Sales Commission Report</h2>

                    <div class="row mb-4">
                        <div class="col-6">
                            <strong>Salesperson:</strong>
                            <span t-esc="env.context.get('wizard_salesperson_name')"/>
                        </div>
                        <div class="col-6 text-end">
                            <strong>Period:</strong>
                            <span t-esc="env.context.get('wizard_start_date')"/> to
                            <span t-esc="env.context.get('wizard_end_date')"/>
                        </div>
                    </div>

                    <table class="table table-sm table-bordered">
                        <thead>
                            <tr>
                                <th>Period</th>
                                <th>Commission Plan</th>
                                <th class="text-end">Target Amount</th>
                                <th class="text-end">Achieved</th>
                                <th class="text-end">Achieved Rate</th>
                                <th class="text-end">Commission</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="docs" t-as="line">
                                <tr>
                                    <td><span t-esc="line.period"/></td>
                                    <td><span t-esc="line.plan_id.name"/></td>
                                    <td class="text-end"><span t-esc="'%.2f' % line.target_amount"/></td>
                                    <td class="text-end"><span t-esc="'%.2f' % line.achieved"/></td>
                                    <td class="text-end"><span t-esc="'%.2f' % line.achieved_rate"/>%</td>
                                    <td class="text-end"><span t-esc="'%.2f' % line.commission"/></td>
                                    <td><span t-esc="line.state"/></td>
                                </tr>
                            </t>
                        </tbody>
                        <tfoot>
                            <tr>
                                <th colspan="3" class="text-end">Total</th>
                                <th class="text-end"><span t-esc="'%.2f' % sum(docs.mapped('achieved'))"/></th>
                                <th/>
                                <th class="text-end"><span t-esc="'%.2f' % sum(docs.mapped('commission'))"/></th>
                                <th/>
                            </tr>
                        </tfoot>
                    </table>

                    <p t-if="not docs">
                        No commission records found for the selected salesperson and date range.
                    </p>
                </div>
            </t>
        </t>
    </template>

</odoo>