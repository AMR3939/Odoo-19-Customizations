<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Update the standard eCommerce dashboard supplied by
        spreadsheet_dashboard_website_sale.
        The JSON file below is the complete customized dashboard definition.
    -->
    <record id="spreadsheet_dashboard_website_sale.spreadsheet_dashboard_ecommerce"
            model="spreadsheet.dashboard">
        <field name="spreadsheet_binary_data"
               type="base64"
               file="spreadsheet_dashboard_website_sale_enhancements_withAI/data/files/ecommerce_dashboard.json"/>
        <field name="sample_dashboard_file_path">
            spreadsheet_dashboard_website_sale_enhancements_withAI/data/files/ecommerce_sample_dashboard.json
        </field>
    </record>
</odoo>
